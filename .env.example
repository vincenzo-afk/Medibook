TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="dev-cron-secret"
SENTRY_DSN=""
